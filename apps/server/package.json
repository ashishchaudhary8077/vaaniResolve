{
  "name": "@vaaniresolve/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "test:solo": "node --import tsx --test src/stress.test.ts",
    "demo": "node --import tsx src/demo.ts",
    "eval": "node --import tsx src/evaluate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@vaaniresolve/agent": "*",
    "@vaaniresolve/rime": "*",
    "@vaaniresolve/shared": "*",
    "@vaaniresolve/state": "*",
    "@vaaniresolve/tools": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}