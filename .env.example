# ─── VaaniResolve environment ─────────────────────────────────────────────
# Copy to `.env` and fill in secrets. `.env` is git-ignored — NEVER commit it.

# Rime TTS — PRIMARY and ESSENTIAL voice provider.
# Get a key at https://users.rime.ai/  (copies of keys must never be committed).
RIME_API_KEY= 
RIME_MODEL=rime-tts
RIME_SPEAKER=violet
RIME_LANGUAGE=en
RIME_ENDPOINT=https://users.rime.ai/v1/rSpeech
RIME_SAMPLE_RATE=24000

# LLM agent (optional — the disclosed deterministic agent runs without a key).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-1

# Server
PORT=8789
# Optional deterministic tool-behaviour overrides (demo/stress).
# TOOL_LATENCY=getOrder=4000,trackOrder=4000
# TOOL_FAIL=cancelOrder
# STRESS_LAPTOP_MS=4000